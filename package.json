{
  "name": "shia-fiqh-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Comparative Shia fiqh platform — maraji corpus, search, and grounded Q&A",
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -p 3000",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "import": "tsx --env-file=.env.local scripts/import.ts",
    "fiqh:seed": "tsx --env-file=.env.local scripts/fiqh/seed-corpus.ts",
    "fiqh:migrate": "tsx --env-file=.env.local scripts/fiqh/apply-schema.ts",
    "fiqh:import": "tsx --env-file=.env.local scripts/fiqh/import-real-corpus.ts",
    "fiqh:seed-maraji": "tsx --env-file=.env.local scripts/fiqh/seed-remaining-maraji.ts",
    "fiqh:expand": "tsx --env-file=.env.local scripts/fiqh/expand-corpus.ts",
    "fiqh:expand-existing": "tsx --env-file=.env.local scripts/fiqh/expand-existing-maraji.ts",
    "fiqh:seed-mass": "tsx --env-file=.env.local scripts/fiqh/seed-mass-corpus.ts",
    "fiqh:seed-aggressive": "tsx --env-file=.env.local scripts/fiqh/seed-aggressive.ts",
    "fiqh:setup": "npm run fiqh:migrate && npm run fiqh:import -- --wipe",
    "db:probe": "tsx --env-file=.env.local scripts/probe-supabase.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/auth-helpers-react": "^0.4.0",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/kv": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "^3.0.0",
    "autoprefixer": "10.4.20",
    "eslint-config-next": "^15.5.24",
    "js-tiktoken": "^1.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "0.469.0",
    "mammoth": "^1.6.0",
    "next": "^15.5.24",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.4.0",
    "postcss": "^8.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "3.4.17",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "5.7.3"
  }
}
