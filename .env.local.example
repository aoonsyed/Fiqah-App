# Supabase Configuration
# Get these from: https://app.supabase.com/project/[your-project]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct Postgres (required once for npm run fiqh:migrate — Dashboard → Settings → Database)
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or set password only (migrate tries aws-0/aws-1 pooler regions automatically):
# SUPABASE_DB_PASSWORD=
# Optional if auto-detect fails — paste Session URI from Dashboard → Connect:
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Gemini API (answers + reranking)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_RERANK_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Embeddings run locally (Xenova/multilingual-e5-small); no key needed.

# Aladhan API (Prayer Times)
# Free, no API key needed
NEXT_PUBLIC_ALADHAN_API_BASE=https://api.aladhan.com/v1

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown on /privacy for data/deletion requests
# NEXT_PUBLIC_CONTACT_EMAIL=privacy@your-domain.com
# Don't set NODE_ENV here — next dev/build set it. Forcing "development" in
# production turns on verbose errors and dev-only behaviour.

# Feature Flags
ENABLE_DAILY_HADITH_CRON=false
ENABLE_QIBLA_FEATURE=true
ENABLE_PRAYER_TIMES=true
ENABLE_FIQH_CORPUS=true

# Security
# Long random value in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=dev-secret-change-in-production
# Comma-separated admin accounts (server-only; never NEXT_PUBLIC_)
ADMIN_EMAILS=
