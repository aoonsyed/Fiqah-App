# Supabase Configuration
# Get these from: https://app.supabase.com/project/[your-project]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anthropic API (Claude)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Embedding Provider
EMBEDDING_PROVIDER=anthropic
EMBEDDING_MODEL=text-embedding-3-large

# Aladhan API (Prayer Times)
# Free, no API key needed
NEXT_PUBLIC_ALADHAN_API_BASE=https://api.aladhan.com/v1

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Feature Flags
ENABLE_DAILY_HADITH_CRON=false
ENABLE_QIBLA_FEATURE=true
ENABLE_PRAYER_TIMES=true

# Security
CRON_SECRET=dev-secret-change-in-production
